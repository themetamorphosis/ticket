# Copy to .env (gitignored) to override local host ports when 5432/6379 are taken.
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
WEB_HOST_PORT=8088

# Payment gateway for the local stack: fake (default), bkash or paystation.
# Real credentials go only in .env (gitignored), never in the repository.
PAYMENT_PROVIDER=fake
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2/tokenized-checkout
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# PAYSTATION_BASE_URL=https://sandbox.paystation.com.bd
# PAYSTATION_MERCHANT_ID=
# PAYSTATION_PASSWORD=

# Ticket delivery. TICKET_KEY is 32 random bytes, base64 (openssl rand -base64 32).
# TICKET_KEY=
# GATE_ORIGIN=https://gate.example.org
# EMAIL_PROVIDER=smtp
# SMTP_ADDR=smtp.example.org:587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=Kacheem Comms Tickets <tickets@example.org>
